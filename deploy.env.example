# Copy this file to deploy.env and edit it before running Docker Compose.
# `deploy.env` and the referenced secret files are ignored by Git and Docker.

# The externally visible origin. Public deployments must use HTTPS.
PUBLIC_ORIGIN=https://workshop.example.org

# Used only by the optional Caddy `proxy` profile. Point this DNS name at the VPS.
SITE_DOMAIN=workshop.example.org

# Optional former hostname. Copy the legacy-domain redirect example as described
# in DOCKER_DEPLOYMENT.md when migrating an existing deployment.
LEGACY_SITE_DOMAIN=

# Optional direct-IP HTTPS access; also enable deploy/ip-access.caddy.example
# as described in DOCKER_DEPLOYMENT.md. Leave empty for domain-only deployment.
SITE_IP=
PUBLIC_IP_ORIGIN=

# Keep the application port private when Caddy is the public entry point.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3001
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Host paths to one-line secret files. The legacy admin key must be 12–128
# characters. The participant passcode must be 8–64 characters and not a
# placeholder such as `a`, `password`, `changeme`, `demo`, or `workshop`.
LOCAL_ADMIN_KEY_FILE=./secrets/local_admin_key.txt
WORKSHOP_PARTICIPANT_PASSCODE_FILE=./secrets/participant_passcode.txt
